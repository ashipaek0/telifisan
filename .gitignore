```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
node_modules/

# Build outputs
frontend/dist/

# Environment variables
.env
.env.local
.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage reports
.coverage
coverage/
htmlcov/

# Python virtual environments
venv/
.venv/
```